<!--
  Monochrome status-bar / notification icon: the FocusForce+ target, reduced to
  what survives being drawn as a pure alpha silhouette at ~18dp.

  Notification small icons are flattened to alpha, so this uses only a stroked
  ring, four solid crosshair arms and a centre dot — no gradients, no fine
  detail, no group transforms. The detailed launcher artwork came out as the
  grey Android placeholder at this size, which is why a plain bolt stood here
  before; this keeps the app's own mark instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Ring -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M12,4.5a7.5,7.5 0 1,0 0.01,0z" />

    <!-- Crosshair arms, crossing the ring from outside to inside -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11,1.5h2v5.5h-2z M11,17h2v5.5h-2z M1.5,11h5.5v2h-5.5z M17,11h5.5v2h-5.5z" />

    <!-- Centre -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,9.8a2.2,2.2 0 1,0 0.01,0z" />
</vector>
