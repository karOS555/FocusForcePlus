<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Notification & alarm permissions ──────────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Android 16+: lets the running routine / focus / sleep notification be
         promoted to a Live Update — status bar chip, lock screen, always-on
         display, and the Now Bar on One UI. Normal permission, granted at install;
         only ever used for a session the user started themselves. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required for startActivity() to work when another app is in the foreground.
         All alarm apps (Alarmy, Sleep as Android, etc.) need this. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 13+: automatically granted, enables setExactAndAllowWhileIdle() for pre-alarms. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Android 12: user must grant this manually; we prompt in MainActivity if needed.
         setAlarmClock() is always exempt regardless of this permission. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ExactAlarm" />

    <!-- Foreground services. All our services are user-initiated session holders
         (routine/focus timers, pinned alarm notifications) — none of the specific
         FGS types fit, so each declares specialUse with an explanatory subtype
         property (see the <service> tags). Google requires a Play Console
         declaration for specialUse; the subtype values below are written for it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Boot receiver -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Sleep mode: optionally create backup wake-up alarms in the user's own clock
         app, so they ring even if FocusForce+ is not running. Normal permission,
         granted at install; each alarm is created only from the user's explicit
         sleep-schedule setting. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Focus mode: toggle Do Not Disturb during sessions. Declaring this is what
         makes FocusForce+ appear in Android's "Do Not Disturb access" list — the
         actual grant still happens there, by the user. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Calendar (optional, asked after an in-app disclosure): today's events on Home,
         dated todos into a calendar the user picks, blocking during events. Read and
         written on the device only; the app has no internet access. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Tasks app sync (optional, asked after an in-app disclosure): one list of
         OpenTasks or Tasks.org is kept in step with the todos. Both apps define
         these permissions; Tasks.org ships the OpenTasks provider under its own name. -->
    <uses-permission android:name="org.dmfs.permission.READ_TASKS" />
    <uses-permission android:name="org.dmfs.permission.WRITE_TASKS" />
    <uses-permission android:name="org.tasks.permission.READ_TASKS" />
    <uses-permission android:name="org.tasks.permission.WRITE_TASKS" />

    <!-- App blocker: measure per-app usage for daily limits. Special-access permission,
         granted by the user in system settings after an in-app prominent disclosure. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility: only apps with a launcher entry (the blockable ones).
         Deliberately NOT QUERY_ALL_PACKAGES — see .claude/PLAY_STORE_COMPLIANCE.md,
         Golden Rule #6. -->
    <queries>
        <!-- The two task providers the task sync can talk to, nothing else. -->
        <provider android:authorities="org.dmfs.tasks" />
        <provider android:authorities="org.tasks.opentasks" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Lets us check whether this device actually ships the per-app
             full-screen-notification screen before sending the user there.
             Several OEMs (Samsung One UI) do not — see PermissionHelper. -->
        <intent>
            <action android:name="android.settings.MANAGE_APP_USE_FULL_SCREEN_INTENTS" />
            <data android:scheme="package" />
        </intent>
        <!-- Same check for the Android 16 Live Updates screen, which One UI 8
             also does not ship. -->
        <intent>
            <action android:name="android.settings.MANAGE_APP_PROMOTED_NOTIFICATIONS" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:name=".FocusForcePlusApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusForce">

        <!-- Full-screen alarm activity — shown over the lock screen when a routine fires -->
        <activity
            android:name=".ui.alarm.RoutineAlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FocusForce" />

        <!-- Full-screen alarm activity for scheduled todos -->
        <activity
            android:name=".ui.alarm.TodoAlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FocusForce" />

        <!-- Main activity — also the target for alarm full-screen intents -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.FocusForce.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Text shared from another app becomes a todo or list items. No permission
             involved: the user picks the target on the sheet. -->
        <activity
            android:name=".ui.share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/share_label"
            android:theme="@style/Theme.FocusForce.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- focusforceplus:// start links from automation apps, shortcuts and NFC tags.
             They do nothing until the user switches them on in Settings, and they can
             only start and add, never stop or cancel (see util/ExternalStarts.kt).
             Deliberately not BROWSABLE, so a web page cannot fire them. -->
        <activity
            android:name=".ui.share.LinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FocusForce.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="focusforceplus" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="focusforceplus" />
            </intent-filter>
        </activity>

        <!-- Short-lived service that starts RoutineAlarmActivity from background -->
        <service
            android:name=".service.AlarmLaunchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Launches the full-screen routine alarm the user scheduled; alive for under a second." />
        </service>

        <!-- Foreground service that keeps the process alive during a routine session -->
        <service
            android:name=".service.RoutineForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-started routine timer running with a live countdown notification until the routine ends." />
        </service>

        <!-- Receives scheduled routine alarms (main alarm + snooze) -->
        <receiver
            android:name=".service.RoutineAlarmReceiver"
            android:exported="false" />

        <!-- Safety alarm at each task's end — revives the session service if killed -->
        <receiver
            android:name=".service.RoutineTaskEndReceiver"
            android:exported="false" />

        <!-- Receives the 15-minute pre-alarm and shows a reminder notification -->
        <receiver
            android:name=".service.RoutinePreAlarmReceiver"
            android:exported="false" />

        <!-- Handles "Snooze" actions from the pre-alarm notification -->
        <receiver
            android:name=".service.RoutineRescheduleReceiver"
            android:exported="false" />

        <!-- Handles "Dismiss" taps from alarm and snooze notifications -->
        <receiver
            android:name=".service.RoutineDismissReceiver"
            android:exported="false" />

        <!-- Handles "Done" action from the active-routine foreground notification -->
        <receiver
            android:name=".service.RoutineSessionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.focusforceplus.app.SESSION_COMPLETE_TASK" />
                <action android:name="com.focusforceplus.app.SESSION_ADD_TIME" />
                <action android:name="com.focusforceplus.app.SESSION_CANCEL" />
            </intent-filter>
        </receiver>

        <!-- Re-arms alarms after reboot, app update, and clock/timezone changes -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- A todo's single wake-up: due time, end of a snooze, or the next repeat -->
        <receiver
            android:name=".service.TodoAlarmReceiver"
            android:exported="false" />

        <!-- Buttons on todo notifications, and the swipe that brings one back -->
        <receiver
            android:name=".service.TodoActionReceiver"
            android:exported="false" />

        <!-- The daily reminder times for open todos -->
        <receiver
            android:name=".service.TodoDigestReceiver"
            android:exported="false" />

        <!-- Rings a due todo. Runs only while something is ringing and stops by
             itself after a short, fixed time. -->
        <service
            android:name=".service.TodoAlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Sounds the alarm of a due todo the user scheduled; stops by itself after a short fixed time or as soon as the user answers it." />
        </service>

        <!-- App blocker: detects which app is in the foreground (window state changes
             only, no content access) and shows the blocked screen. Config is minimal
             by design — see res/xml/accessibility_service_config.xml. -->
        <service
            android:name=".service.AppBlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Opt-in and separate from the blocker above: leaves Reels in Instagram and
             Shorts in YouTube. Limited to those two apps; see
             res/xml/short_form_service_config.xml. Off until the user turns it on
             after its own disclosure screen. -->
        <service
            android:name=".service.ShortFormBlockerService"
            android:exported="false"
            android:label="@string/short_form_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/short_form_service_config" />
        </service>

        <!-- Full-screen cover for blocked apps. Isolated task, never in recents,
             disappears once left — the user can always reach Home. -->
        <activity
            android:name=".ui.screens.blocker.BlockedAppActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FocusForce" />

        <!-- Owns a running focus session: countdown, ongoing notification, DND -->
        <service
            android:name=".service.FocusForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the user-started focus session countdown and restores Do Not Disturb when it ends." />
        </service>

        <!-- Fires at a focus session's scheduled time (reminder, no auto-start) -->
        <receiver
            android:name=".service.FocusAlarmReceiver"
            android:exported="false" />

        <!-- Drives the sleep schedule: wind-down reminder, bedtime, wake-up -->
        <receiver
            android:name=".service.SleepReceiver"
            android:exported="false" />

        <!-- Handles "End session" / "Start now" actions from focus notifications -->
        <receiver
            android:name=".service.FocusSessionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.focusforceplus.app.FOCUS_END_SESSION" />
                <action android:name="com.focusforceplus.app.FOCUS_START_SCHEDULED" />
            </intent-filter>
        </receiver>

        <!-- Quick-settings tile: start a 25-min quick focus with one tap.
             exported=true is required for system binding; the BIND permission
             restricts callers to the system. -->
        <service
            android:name=".service.FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_focus"
            android:label="Quick focus"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home-screen widgets. APPWIDGET_UPDATE is a protected broadcast: only the
             system sends it. Taps inside a widget only open the app or tick off a
             list item / start a quick focus session, like the same tap in the app. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".widget.FocusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_focus_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_focus_info" />
        </receiver>
        <receiver
            android:name=".widget.ListWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_list_info" />
        </receiver>
        <!-- The launcher opens this when a list widget is placed; it only picks a list. -->
        <activity
            android:name=".widget.ListWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusForce"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
